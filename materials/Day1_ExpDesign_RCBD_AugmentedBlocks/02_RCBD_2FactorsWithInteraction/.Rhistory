###############################################################################################
######### CASE STUDY PRESENTATION #############################################################
# In the frame of a watermelon breeding program, two varieties were crossed to improve SugarContent content.
# In order to evaluate the interest of crossing these two varieties, we compare the performances of the parental varieties and F1 progenies.
# For this, the SugarContent content was evaluated during a greenhouse trial under semi-controlled environmental conditions (Datafile: RCBD_SugarPloidyWatermelon.csv).
# We hypothesize that there is no genotype-environment interaction effect for the 'SugarContent content' character.
######### PREPARATION OF THE WORKING INTERFACE IN R ###########################################
### I. Set working directory
#On RStudio: tab 'Session'-> Set Working Directory -> Choose Directory.
#Choose the directory containing the datafile and the associated R script.
### II. Installation R packages needed for the analysis on RStudio:
#Click on the 'Packages' tab in the bottom-right window of R Studio interface->'Install Packages'
#Comment #1: R package installation requires a connection to internet
#Comment #2: Once packages have been installed, no need to re-install them again when you close-open again RStudio.
### III. Initialisation of the working space
# To erase all graphs
graphics.off()
# To erase objects from the working space - Clean up of the memory
rm(list = ls())
# use of the conPloidyt 'sum-to-zero' for ANOVAs
options(contrasts=c('contr.sum','contr.poly'))
#contr.sum: sum of effects of factors = 0
#############################################################################################################
## Loading of the R packages needed for the analysis.
library(ggplot2) # Needed for some graphs (e.g. bwplots)
library(gridExtra)
library(tidyverse)
###################
# Data import in R
###################
SugarContent <- read.table('RCBD_SugarPloidyWatermelon.csv',header = TRUE, sep = ";", dec = ",")
# to load datasets : nom, header = true for labels
SugarContent
str(SugarContent)
SugarContent$Genotype <- relevel(SugarContent$Genotype, "ChXM-F1")  ## to fit with data order. May be modified as required
attach(SugarContent)# It avoids having to specify the name of the dataframe in R commands i.e. it is no more useful to write Dataframe$factor or Dataframe$variable
##Check for balanced dataset :
table(Genotype,Ploidy,Rep)
table(Genotype,Ploidy)
########################
# CHECK POINT !
########################
#
# Identify the factors, and name the experimental design
# propose a practical set up of this design, in the field or in greenhouse
# which practical data (or informations) are lacking ?
#
########################
########################
# Graphic visualizations
########################
##Boxplots to reveal the distribution and variance of the measured traits depending on the different factors of interest
graf1 <- ggplot(SugarContent, aes(x = Genotype, y = Sugar)) +
geom_boxplot() + geom_jitter(width = 0.15)
x11()
graf1 <- ggplot(SugarContent, aes(x = Genotype, y = Sugar)) +
geom_boxplot() + geom_jitter(width = 0.15)
x11()
graf1 <- ggplot(SugarContent, aes(x = Genotype, y = Sugar)) +
geom_boxplot() + geom_jitter(width = 0.15)
graf1 <- ggplot(SugarContent, aes(x = Genotype, y = Sugar)) +
geom_boxplot() + geom_jitter(width = 0.15)
graf2 <- ggplot(SugarContent, aes(x = Rep, y = Sugar)) +
geom_boxplot() + geom_jitter(width = 0.15)
x11()
grid.arrange(graf1, graf2, ncol = 2, nrow = 1)
graf3 <- ggplot(SugarContent, aes(x = Ploidy, y = Sugar)) +
geom_boxplot() + geom_jitter(width = 0.15) +
facet_grid( . ~ Genotype)
graf4 <- ggplot(SugarContent, aes(x = Genotype, y = Sugar)) +
geom_boxplot() + geom_jitter(width = 0.15) +
facet_grid( . ~ Ploidy)
x11()
grid.arrange(graf3, graf4, ncol = 1, nrow = 2)
#Interaction plots to get a more comprehensive view of the effect of the interaction of 2 factors on an agronomical trait of interest.
x11()
interaction.plot(Ploidy, Genotype, Sugar,
type = "b",
xlab="Ploidy",ylab="Sugar Content",trace.label="Genotypes",
pch=c(1:10),cex=2, lty=1,lwd=2,col=c(1:10))
x11()
interaction.plot(Genotype,Ploidy,Sugar,
type="b",
xlab="Genotypes",ylab="Sugar Content",trace.label="Ploidy",
pch=c(1:10),cex=2, lty=1,lwd=2,col=c(1:10))
###############  ANOVA : 2 factors without interaction - to illustrate the matrix model of LMMs
###############  new school method: use of lmer function for Linear Mixed Models
## WARNING : 5 RANDOM EFFECTS is a fairly small number of random-effect levels.
## You may consider setting Rep as a fixed effect (possibly with sum-to-zero contrasts, i.e. specify contrasts=list(Rep = contr.sum)).
library(lme4)
ana1 <- lme4::lmer( Sugar ~ Genotype + Ploidy + (1 | Rep))  ## REML true par défaut
summary(ana1)
anova(ana1)
levels(Genotype); levels(Ploidy)
fixef(ana1)
coefFixes <- fixef(ana1); names(coefFixes) <- c("mu","alpha1","alpha2","beta1","beta2")
coefFixes
ranef(ana1)
library(lmerTest) ### To get the p-values
ana2 <- lmerTest::lmer( Sugar ~ Genotype + Ploidy + (1 | Rep))
summary(ana2)
anova(ana2)
fixef(ana2)
ranef(ana2)  ## levels are assigned by alphabetic order, not in the order of the data.
###############
############### reconstructing observed values from model parameters
## Matrices of the design, with 'sum-to-zero' conPloidyt on the fixed effect
## by default, the LAST effect by alphabetic order is set to 'sum-to-zero' conPloidyt. It is possible to modify this settings
##
## design matrix  (see ?getME)
getME(ana1,'X')
## random effects matrix :
t(as.matrix(getME(ana1,'Zt')))  ## Zt is the transposed of Z, so use t(Zt) to get it in the data sens.
##
## to get the order the levels were encoded.
levels(SugarContent$Genotype)
levels(SugarContent$Ploidy)
## So Maboubi = -ChXM-F1 - CharlestonGrey
## So Ploidy3 = -Ploidy1 - Ploidy2
## CharlestionGrey, Ploidy1 in Rep 1 observed value :
SugarContent[Genotype == "CharlestonGrey" & Ploidy == "Ploidy1" & Rep == "R1", ]  ## row 1 of the dataset
# model fixed parameters :
getME(ana1,'X')[1, ]
# intercept + effect 2 of Genotype (CharlestonGrey) + effect 1 of Ploidy (Ploidy1) + random effect of Rep 1 + residual[1] (because first value in dataset)
11.6484444 + -0.1657778 -1.0664444 + 3.08163778 + residuals(ana1)[1]
##
predict(ana1)[1]
predict(ana1)[1] +  residuals(ana1)[1]
## Maboubi, Ploidy2 in Rep 3
SugarContent[Genotype == "Maboubi" & Ploidy == "Ploidy2" & Rep == "R3", ]  ## row 23 of the dataset
# model fixed parameters :
getME(ana1,'X')[23, ]
# intercept + effect of Genotype Maboubi (sum-to-zero) + effect 2 of Ploidy (Ploidy2) + effect of Rep 3 + residual[23] (because 23th value in dataset)
# because of the 'sum-to-zero' conPloidyts on the coefficients, understand how the effect of Maboubi is computed
11.6484444 + (-1.6184444) + 0.8195556 + (-0.27886930) + residuals(ana1)[23]
##
predict(ana1)[23]
predict(ana1)[23] +  residuals(ana1)[23]
## ## Charleston, Ploidy 3  in Rep 5. Less easy !
## SugarContent[Genotype == "CharlestonGrey" & Ploidy == "Ploidy3" & Rep == "R5", ]  ## row 39 of the dataset
## # model fixed parameters :
## getME(ana1,'X')[39, ]
## # intercept + effect 2 of Genotype (Charleston) + effect Ploidy 4X (sum-to-zero) + effect of Rep 5 + residual[39] (because 39th value in dataset)
## 11.6484444 + (-0.1657778)  - (-1.0664444 + 0.8195556) + (-0.28986573) + residuals(ana1)[39]
## ##
## predict(ana1)[39]
## predict(ana1)[39] +  residuals(ana1)[39]
## Once again : Matrices of the design, with 'sum-to-zero' conPloidyt on the fixed effect
## by default, the LAST effect by alphabetic order is set to 'sum-to-zero' conPloidyt. It is possible to modify the default settings
## design matrix  (see ?getME)
getME(ana1,'X')
## random effects matrix :
t(as.matrix(getME(ana1,'Zt')))  ## Zt is the transposed of Z, so use t(Zt) to get it in the design sens.
# Xb
Fix.BLUEs <- getME(ana1,'X') %*% fixef(ana1)
Fix.BLUEs
# Zu
Ran.BLUPs <- t(as.matrix(getME(ana1,'Zt'))) %*% unlist(ranef(ana1))
Ran.BLUPs
# Xb + Zu
Predict <- Fix.BLUEs + Ran.BLUPs
Predict
## compare with result of predict()function of ana1 model, rounding number to 6digits
all(round((Predict),6) == round(predict(ana1),6))
#Possible to test for effect of interactions between the 2 factors genotype and Ploidy because for each combination "genotype x Ploidy" data number = 5 (i.e. >2)
###############  ANOVA : 2 factors with interaction
###############  new school method: use of lmer function for Linear Mixed Models
model <- lme4::lmer( Sugar ~ Genotype * Ploidy + (1 | Rep))
summary(model)
anova(model)
modelb <- lmerTest::lmer( Sugar ~ Genotype * Ploidy + (1 | Rep))  # to get p-values
summary(modelb)
anova(modelb)
#Quality of prediction
x11()
plot(model)
##### Formal Tests of ANOVA Model Assumptions
# The Shapiro-Wilk test for normality of ANOVA residuals is produced by:
shapiro.test(resid(modelb))
## BLUEs and BLUPs of effects
fixef(model)
ranef(model)
# to check for consistency
var(ranef(model)$Rep)  ## approx sigma_Rep
#### Multiple mean comparison test
## Adjusted means (IMPORTANT : because the design is balanced, adjusted means = means from the data)
library(lsmeans)
## NO significant interactions.
## The below syntax would be used in case of significant interactions.
## AdjustMoys1 <- lsmeans::lsmeans(model,   ## lmerTest is masking standard lsmeans. Unwanted !
##                      pairwise ~ Genotype:Ploidy,
##                      adjust = "tukey")
## ## Options are "tukey", "scheffe", "sidak", "bonferroni", "dunnettx", "mvt", and "none"
AdjustMoys2 <- lsmeans::lsmeans(model,  ## lmerTest is masking standard lsmeans. Unwanted !
pairwise ~ Genotype,
adjust = "tukey")
AdjustMoys3 <- lsmeans::lsmeans(model,  ## lmerTest is masking standard lsmeans. Unwanted !
pairwise ~ Ploidy,
adjust = "tukey")
## Multiple comparisons
## Note that the adjust= option should also be applied to the cld function if a compact letter display is requested.
## (CompMoys1 <- cld(AdjustMoys1,  ## cld for compact letter display
##     alpha = 0.01 ,
##     Letters = letters ,
##     adjust = "tukey"
##     )
## )
(CompMoys2 <- cld(AdjustMoys2,
alpha = 0.05 ,
Letters = letters ,
adjust = "tukey"
)
)
(CompMoys3 <- cld(AdjustMoys3,
alpha = 0.05 ,
Letters = letters ,
adjust = "tukey"
)
)
########################
# Power  a priori , a posteriori
########################
library(pwr)
# we will consider the following situation for a priori computations : two genotypes (or two stains) differ by 5% or 10% of the grand mean.
# all the other effects are equal to the grand mean
# we will use the residual variance as the true error variance.
mu <- mean(Sugar)
sigma2 <-  (attr(VarCorr(model), "sc"))^2  ## cryptic syntax, sorry
NbGenotypes <- length(levels(Genotype))
NbPloidys <- length(levels(Ploidy))
table(Genotype)
PiG <- 15/45  ## 15 measurment of each genotype and 3 genotypes ie 45 values
table(Ploidy)
PiS <- 15/45 ## # 15 measurment of each Ploidy and 3 Ploidys ie 45 values
## For Genotypes:
## the a priori data are (for 5%)
## let use delta = 5%
theo1 <- data.frame( theo = c(mu - mu*.025, mu + mu*.025, rep(mu,NbGenotypes - 2)) )
EffectSizePrioriA <- theo1 %>%
mutate(diff = PiG * (theo - mu )^2) %>%
summarise( sum(diff)) %>%
{sqrt(as.numeric(.)/sigma2)} %>%  ## à la con
as.numeric  ## à la con également
## Wrapping the last call into curly braces makes it be treated like an expression and not a function call.
## When you pipe something into an expression, the . gets replaced as expected. I often use this trick to call a function which does not interface well with piping.
## What is inside the braces happens to be a function call but could really be any expression of . .
pwr.anova.test(k = 3, n = 15, f = EffectSizePrioriA, sig.level = c(0.05, 0.1, 0.20))  ## do not forget to adjust k and n
## let use  delta = 10%
theo2 <- data.frame( theo = c(mu - mu*.05, mu + mu*.05, rep(mu,8)) )
EffectSizePrioriB <- theo2 %>%
mutate(diff = PiG * (theo - mu )^2) %>%
summarise( sum(diff)) %>%
{sqrt(./sigma2)} %>%   ## à la con
as.numeric  ## à la con également
## Wrapping the last call into curly braces makes it be treated like an expression and not a function call.
pwr.anova.test(k = 10, n = 4, f = EffectSizePrioriB, sig.level = c(0.05, 0.1, 0.20))
############
## power  a posteriori
EffectSize <- SugarContent %>%
group_by(Genotype) %>%
summarise(Moy = mean(Sugar)) %>%
mutate(diff = PiG * (Moy - mean(Sugar))^2) %>%
summarise( sum(diff)) %>%
{sqrt(as.numeric(.)/sigma2)}  ## à la con !
## Wrapping the last call into curly braces makes it be treated like an expression and not a function call.
pwr.anova.test(k = 3, n = 15, f = EffectSize, sig.level = 0.05)  ## do not forget to adjust k and n
########################
# CHECK POINT !
########################
#
# what if we did not define blocks ?
#
########################
ReducedModel <- aov( Sugar ~ Genotype * Ploidy)
summary(ReducedModel)
# Note that sigma2_block + sigma2_residual of the mixed model) = sigma2_residual of FixedModel
# Important to understand : the variabilty due to blocks is put into the residual of FixedModel
VarCorr(model)
1.98271^2 + 0.63875^2
## Increase in power by adding blocks :
4.34/sigma2  ## approx ten times !!
AdjustMoys4 <- lsmeans::lsmeans(ReducedModel,
pairwise ~ Genotype,
adjust = "tukey")
AdjustMoys5 <- lsmeans::lsmeans(ReducedModel,
pairwise ~ Ploidy,
adjust = "tukey")
(CompMoys4 <- cld(AdjustMoys4,
alpha = 0.05 ,
Letters = letters ,
adjust = "tukey"
)
)
# compare to CompMoys2
(CompMoys5 <- cld(AdjustMoys5,
alpha = 0.05 ,
Letters = letters ,
adjust = "tukey"
)
)
# compare to CompMoys3
############
## power  a posteriori
table(Genotype)
PiG <- 15/45  ## 15 measurment of each genotype and 3 genotypes ie 45 values
sigma2Red <- 4.34
EffectSize <- SugarContent %>%
group_by(Genotype) %>%
summarise(Moy = mean(Sugar)) %>%
mutate(diff = PiG * (Moy - mean(Sugar))^2) %>%
summarise( sum(diff)) %>%
{sqrt(as.numeric(.)/sigma2Red)}  ## à la con !
## Wrapping the last call into curly braces makes it be treated like an expression and not a function call.
pwr.anova.test(k = 3, n = 15, f = EffectSize, sig.level = 0.05)  ## do not forget to adjust k and n
## even if not catastrophic due to large effect size, the decrease in power is noticeable.

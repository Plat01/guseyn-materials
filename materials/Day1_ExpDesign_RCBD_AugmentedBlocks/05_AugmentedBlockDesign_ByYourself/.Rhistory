B1=model.tables(AnaChecks)$tables$block[1],
B2=model.tables(AnaChecks)$tables$block[2],
B3=model.tables(AnaChecks)$tables$block[3],
B4=model.tables(AnaChecks)$tables$block[4],
B5=model.tables(AnaChecks)$tables$block[5],
B6=model.tables(AnaChecks)$tables$block[6]
)
Produc$yieldCorr <- Produc$yield - Produc$effetblock

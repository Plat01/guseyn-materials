#Let's analyze the previous code. First we conduct an analysis of variance with the aov() command. The results are stored in the model2 object. Immediately following, we request a summary table with the summary() command.
# The summary command includes the option: split.
# The split option provides a list of factors where contrasts are stored.
# Within each factor, we also provide a list which includes the names of the contrasts (i.e. each column) stored in the contrasts matrix columns (i.e. mat).
### Going further in mean estimations...
# lsmeans : Compute "marginal" means and confidence interval CI of the estimated means
lsmeans(Ana1a, ~ var)
## compare weightCorr et lsmeans
################### Interpretation: which are the accessions different from checks ?
c <- 3
r <- 6
ddl <- (r-1)*(c-1)
MSE <- summary(Ana2)[[1]]$'Mean Sq'[3]  # 3rd term in the column MS of Ana2 summary
# SE of the difference between 2 adj means of selections in different blocks (cf slides)
Sv <- sqrt(2*(c+1)*MSE/c)
#SE of the difference between adjusted selection mean and check. This quantity is the one of interest !
Svc <- sqrt(((r+1)*(c+1)*MSE)/(r*c))
# We want to know which accessions outperform checks.
# t critical value :
qt(0.95,ddl)
LSI <- qt(0.95,ddl) * Svc
LSI
### Each 'adjusted' accession with a value higher (lower) than LSI is different from check
model.tables(AnaChecks,type="means")$tables$var
LimiteUp <- model.tables(AnaChecks,type="means")$tables$var + LSI
max(LimiteUp)
LimiteDn <- model.tables(AnaChecks,type="means")$tables$var - LSI
# To be compared to adjusted means Produc$weightCorr or lsmeans(Ana1a, ~ Accession)
lsmeans(Ana1a, ~ var)
# Although the adjusted yield of 10 of the new selections was greater than the yield of the highest check, C1, none of the yields was significantly higher than any of the check means
###################
######################################  Analysis with agricolae
###################
# To be secure, we specify again constraints on ANOVA effects
options(contrasts=c("contr.sum", "contr.poly"))
##
contrasts(Produc$var) <- "contr.sum"
with(Produc,
by(var, block, as.character)
)
modelDAU1 <- DAU.test(Produc$block, Produc$var, Produc$yield, method = "lsd", console = TRUE)
## The table of "ANOVA, Treatment Adjusted" is in Ana1a ( block + vars)
## The table of "ANOVA, block Adjusted" is in Ana1b (vars + block)
### Please see the contrasts decomposition done in the models AnaFixe1 & AnaFixe2 to understand how agricolae works.
## Small numerical diff on Svc between agricolae et and by-hand computation
options(digits = 2)
modelDAU1$means
### Please see lsmeansand corrected means to xompare with values from agricolae.
## Detail : If we want 2-by-2 pairs comparison and not by group .
modelDAU2 <- DAU.test(Produc$block, Produc$var, Produc$yield, method="lsd", group = FALSE, console = TRUE)
head(modelDAU2$comparison,8)
## In conclusion : agricolae uses a fixed model for ANOVA.
## We can do better than agricolae.
###########
############################################  Analysis in Mixed Linear Model (MLM), all vars
###########
# TO be secure, we specify again the constraints of ANOVA
contrasts(Produc$var) <- "contr.sum"
########### in this example, the number of blocks is too small to
########### accuratly estimate their random effect. BUT we will pursue with this example
########### to compare with fixed models.
library(lmerTest)
library(lsmeans)   # For mean estimation
########### Case 1 : blocks are random effects, genotypes are fixed effects
Ana2a <- lme4::lmer(yield ~ var + (1 | block), data = Produc)
summary(Ana2a)
#print(Ana2a, correlation=TRUE)
#vcov(Ana2a)
anova(Ana2a)     ## note that ddl of fixed effect are NOT specified (for some theoratical reasons)
Ana2b <- lmerTest::lmer(yield ~ var + (1 | block), data = Produc)
summary(Ana2b)

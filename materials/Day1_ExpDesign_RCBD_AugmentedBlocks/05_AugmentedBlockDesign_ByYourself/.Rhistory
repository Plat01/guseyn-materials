Balanced1 <- aov(yield ~ block + var, data = subset(Produc,subset=status == "check"))
summary(Balanced1)
Balanced2 <- aov(yield ~ var + block, data = subset(Produc,subset=status == "check"))
summary(Balanced2)
Balanced3 <- aov(yieldCorr ~ block + var, data = subset(Produc,subset=status == "check"))
summary(Balanced3)
Balanced4 <- aov(yieldCorr ~ var + block, data = subset(Produc,subset=status == "check"))
summary(Balanced4)
# note Block SS in Balanced1/2 vs Balanced 3/4
# note var SS in Balanced1/2 vs Balanced 3/4

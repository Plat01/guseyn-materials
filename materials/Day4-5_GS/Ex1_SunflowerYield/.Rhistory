#################
# analyse brutale
#################
ana1 <- aov(TailleNicotania ~ Variété)
summary(ana1)
#effet Génotype significatif.
#Nous travaillons en conditions contrôlées donc on considère que l'effet des facteurs environnementaux est le même pour tous les génotypes.
#Dans cette hypothèse, si on trouve que les moyennes des 2 parents pour la longueur de l'épi sont statistiquement différentes alors la différence est dû à des facteurs héréditaires.
#Attention! On ne tient pas compte de l'interaction environnement-génotype
shapiro.test(residuals(ana1)) # rÃ©sidus OK
# test de Levene
leveneTest(ana1)
summary(aov(abs(residuals(ana1))~Variété)) #Homogeneité des variances OK
# aie : pas homogÃ©nÃ©itÃ© des variances! est-ce attendu ?
## OUI  VF2 >> Vparents car VF2=VG+VE. Sinon cela voudrait dire qu'il n'y a pas de VG ....
ana1 <- aov(Taille ~ Variété)
summary(ana1)
#effet Génotype significatif.
#Nous travaillons en conditions contrôlées donc on considère que l'effet des facteurs environnementaux est le même pour tous les génotypes.
#Dans cette hypothèse, si on trouve que les moyennes des 2 parents pour la longueur de l'épi sont statistiquement différentes alors la différence est dû à des facteurs héréditaires.
#Attention! On ne tient pas compte de l'interaction environnement-génotype
shapiro.test(residuals(ana1)) # rÃ©sidus OK
# test de Levene
leveneTest(ana1)
summary(aov(abs(residuals(ana1))~Variété)) #Homogeneité des variances OK
# aie : pas homogÃ©nÃ©itÃ© des variances! est-ce attendu ?

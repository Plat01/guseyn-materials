library(Hmisc)
library(gplots)
library(lattice)
library(MASS)
# on efface tous les graphiques
graphics.off()
# note pour effacer les objets de l'espace de travail - nettoyage mÃ©moire
rm(list = ls())
# utilisation de la contrainte 'sum-to-zero' pour les ANOVA
options(contrasts=c('contr.sum','contr.poly'))
#################
# Génération d'un jeu de données aléatoires répondant à l'effectif, la moyenne et la variance
#################
#Pour que le jeu de données générées soit toujours le même
#set.seed<-061277
#Génération d'un jeu de données correspondant aux effectifs, moyennes et variances voulus pour chaque génotype.
P1<- rnorm(n=23, mean=69.44, sd=sqrt(59.73))
P2<- rnorm(n=17, mean=59.04, sd=sqrt(65.71))
F1P1xP2<- rnorm(n=18, mean=83.44, sd=sqrt(51.81))
F1xP1<- rnorm(n=42, mean=76.03, sd=sqrt(81.05))
F1xP2<- rnorm(n=43, mean=71.28, sd=sqrt(90.83))
F2<- rnorm(n=58, mean=74.36, sd=sqrt(100.75))
DataConcat <- c(P1,P2,F1P1xP2,F1xP1,F1xP2,F2)
NicotianaSize <- data.frame(Taille=DataConcat)
NicotianaSize$Variété <- factor(rep(c('P1','P2','F1P1xP2','F1xP1','F1xP2','F2'),c(23,17,18,42,43,58)))
NicotianaSize
str(NicotianaSize)
write.table(NicotianaSize,'NicotianaSize.csv', sep=";", col.names=TRUE, row.names=FALSE)
# pour ne pas avoir Ã  prÃ©ciser le nom du data frame dans les formules
attach(NicotianaSize)
Nicotiana <- read.table("NicotianaSize.csv",sep=";",header=T)
Nicotiana
str(Nicotiana)
#pour ne pas avoir Ã  prÃ©ciser le nom du data frame dans les formules
attach(Nicotiana)
#################
# exploration graphiques
#################
# boxplot en lattice, par concentration et par lignÃ©e
#oui
x11()
boxplot(Taille ~ Variété, las=2, ylab='Taille des Plants de Tabac (cm)')

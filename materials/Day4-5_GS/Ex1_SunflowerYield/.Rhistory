library(Hmisc)
library(gplots)
library(lattice)
library(MASS)
# on efface tous les graphiques
graphics.off()
# note pour effacer les objets de l'espace de travail - nettoyage mÃ©moire
rm(list = ls())
# utilisation de la contrainte 'sum-to-zero' pour les ANOVA
options(contrasts=c('contr.sum','contr.poly'))
#################
# Génération d'un jeu de données aléatoires répondant à l'effectif, la moyenne et la variance
#################
#Pour que le jeu de données générées soit toujours le même
#set.seed<-061277
#Génération d'un jeu de données correspondant aux effectifs, moyennes et variances voulus pour chaque génotype.
P1<- rnorm(n=23, mean=69.44, sd=sqrt(59.73))
P2<- rnorm(n=17, mean=59.04, sd=sqrt(65.71))
F1P1xP2<- rnorm(n=18, mean=83.44, sd=sqrt(51.81))
F1xP1<- rnorm(n=42, mean=76.03, sd=sqrt(81.05))
F1xP2<- rnorm(n=43, mean=71.28, sd=sqrt(90.83))
F2<- rnorm(n=58, mean=74.36, sd=sqrt(100.75))
DataConcat <- c(P1,P2,F1P1xP2,F1xP1,F1xP2,F2)
NicotianaSize <- data.frame(Taille=DataConcat)
NicotianaSize$Variété <- factor(rep(c('P1','P2','F1P1xP2','F1xP1','F1xP2','F2'),c(23,17,18,42,43,58)))
NicotianaSize
str(NicotianaSize)
write.table(NicotianaSize,'NicotianaSize.csv', sep=";", col.names=TRUE, row.names=FALSE)
# pour ne pas avoir Ã  prÃ©ciser le nom du data frame dans les formules
attach(NicotianaSize)
#################
# lecture des donnÃ©es
#################
Nicotiana <- read.table("NicotianaSize.csv",sep=";",header=T)
Nicotiana
str(Nicotiana)
#pour ne pas avoir Ã  prÃ©ciser le nom du data frame dans les formules
attach(Nicotiana)
#################
# exploration graphiques
#################
# boxplot en lattice, par concentration et par lignÃ©e
#oui
x11()
boxplot(Taille ~ Variété, las=2, ylab='Taille des Plants de Tabac (cm)')
#################
# analyse brutale
#################
ana1 <- aov(Taille ~ Variété)
summary(ana1)
#effet Génotype significatif.
#Nous travaillons en conditions contrôlées donc on considère que l'effet des facteurs environnementaux est le même pour tous les génotypes.
#Dans cette hypothèse, si on trouve que les moyennes des 2 parents pour la longueur de l'épi sont statistiquement différentes alors la différence est dû à des facteurs héréditaires.
#Attention! On ne tient pas compte de l'interaction environnement-génotype
shapiro.test(residuals(ana1)) # rÃ©sidus OK
# test de Levene
leveneTest(ana1)
summary(aov(abs(residuals(ana1))~Variété)) #Homogeneité des variances OK
# aie : pas homogÃ©nÃ©itÃ© des variances! est-ce attendu ?
## OUI  VF2 >> Vparents car VF2=VG+VE. Sinon cela voudrait dire qu'il n'y a pas de VG ....
###################################
# Calcul d'hÃ©ritabilitÃ©
## calculs des variances
VarP1<-var(Taille[Variété=='P1'])
VarP1
VarP2<-var(Taille[Variété=='P2'])
VarP2
VarF1P1xP2<-var(Taille[Variété=='F1P1xP2'])
VarF1P1xP2
VarF2<-var(Taille[Variété=='F2'])
VarF2
VarE<-(VarP1+VarP2+VarF1P1xP2)/3
VarE
VarG<-(VarF2-VarE)
VarG
H<-(VarG/VarF2)*100
H
###################################
#Héritabilité au sens strict
#Estimation des variances
VarF1xP1<-var(Taille[Variété=='F1xP1'])
VarF1xP1
VarF1xP2<-var(Taille[Variété=='F1xP2'])
VarF1xP2
###################################
#Estimation des variances
Xvar <- matrix(c(1,0,0,0, 	#P1
1,0,0,0,		#P2
1,0,0,0,		#F1 P1xP2
1,1,1,0,		#F2
1,0.5,1,-1,	#BC1 F1xP1
1,0.5,1,1		#BC1 F1xP2
),byrow=TRUE,nrow=6,ncol=4)
Yvar <- c(VarP1, VarP2, VarF1P1xP2, VarF2, VarF1xP1, VarF1xP2)
Yvar
Xvar
Xvar <- matrix(c(1,0,0,0, 	#P1, P2, F1 P1xP2
1,1,1,0,		#F2
1,0.5,1,-1,	#BC1 F1xP1
1,0.5,1,1		#BC1 F1xP2
),byrow=TRUE,nrow=4,ncol=4)
Yvar <- c(mean(c(VarP1, VarP2, VarF1P1xP2)), VarF2, VarF1xP1, VarF1xP2)
Yvar
Xvar <- matrix(c(1,0,0,0, 	#P1 Ramona
1,0,0,0,		#P2 Baart
1,0,0,0,		#F1 RXB
1,1,1,0,		#F2 BXR
1,0.5,1,-1,	#BC1 BxRXR
1,0.5,1,1		#BC1 BxRXB
),byrow=TRUE,nrow=6,ncol=4)
#Yvar <- c(59.73, 65.71, 51.81, 100.75, 81.05, 90.83)
#Yvar
BetaVar<-solve(t(Xvar)%*%Xvar)%*%t(Xvar)%*%Yvar
BetaVar
BetaVar<-solve(Xvar, Yvar)
BetaVar
Xvar <- matrix(c(1,0,0,0, 	#P1, P2, F1 P1xP2
1,1,1,0,		#F2
1,0.5,1,-1,	#BC1 F1xP1
1,0.5,1,1		#BC1 F1xP2
),byrow=TRUE,nrow=4,ncol=4)
Yvar <- c(mean(c(VarP1, VarP2, VarF1P1xP2)), VarF2, VarF1xP1, VarF1xP2)
Yvar
Xvar <- matrix(c(1,0,0,0, 	#P1 Ramona
1,0,0,0,		#P2 Baart
1,0,0,0,		#F1 RXB
1,1,1,0,		#F2 BXR
1,0.5,1,-1,	#BC1 BxRXR
